{
  "name": "kotlin-implementation-lens",
  "displayName": "Kotlin/Java Implementation Lens",
  "description": "Navigate between Kotlin/Java interfaces and their implementations with CodeLens. Supports abstract classes, Spring Boot annotations, sealed types, and more.",
  "version": "2.0.0",
  "publisher": "fabioods",
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "galleryBanner": {
    "color": "#7B42BC",
    "theme": "dark"
  },
  "keywords": [
    "kotlin",
    "java",
    "interface",
    "implementation",
    "codelens",
    "navigation",
    "spring boot",
    "abstract class",
    "sealed class"
  ],
  "activationEvents": [
    "onLanguage:kotlin",
    "onLanguage:java"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "kotlin-implementation-lens.showImplementations",
        "title": "Kotlin/Java: Show All Implementations"
      },
      {
        "command": "kotlin-implementation-lens.showMethodImplementations",
        "title": "Kotlin/Java: Show Method Implementations"
      },
      {
        "command": "kotlin-implementation-lens.gotoInterface",
        "title": "Kotlin/Java: Goto Interface/Abstract Class"
      },
      {
        "command": "kotlin-implementation-lens.showHierarchy",
        "title": "Kotlin/Java: Show Interface Hierarchy"
      },
      {
        "command": "kotlin-implementation-lens.clearCache",
        "title": "Kotlin/Java: Clear Cache"
      },
      {
        "command": "kotlin-implementation-lens.openSettings",
        "title": "Kotlin/Java: Open Settings"
      }
    ],
    "configuration": {
      "title": "Kotlin/Java Implementation Lens",
      "properties": {
        "kotlinImplementationLens.searchPaths": {
          "type": "array",
          "default": [
            "src/main/kotlin",
            "src/main/java",
            "src",
            "app/src/main",
            "core/src/main"
          ],
          "description": "Directories to search for implementations (Spring Boot structure by default)"
        },
        "kotlinImplementationLens.excludePaths": {
          "type": "array",
          "default": [
            "test",
            "androidTest",
            "**/mocks",
            "**/build",
            "**/target"
          ],
          "description": "Paths to exclude from search"
        },
        "kotlinImplementationLens.showMethodLens": {
          "type": "boolean",
          "default": true,
          "description": "Show method-level CodeLens for interface methods"
        },
        "kotlinImplementationLens.showReverseNavigation": {
          "type": "boolean",
          "default": true,
          "description": "Show 'goto interface' CodeLens on implementation methods"
        },
        "kotlinImplementationLens.filterMocks": {
          "type": "boolean",
          "default": true,
          "description": "Automatically exclude test doubles and mock implementations"
        },
        "kotlinImplementationLens.includeAbstractClasses": {
          "type": "boolean",
          "default": true,
          "description": "Support abstract classes in addition to interfaces"
        },
        "kotlinImplementationLens.includeJavaFiles": {
          "type": "boolean",
          "default": true,
          "description": "Search Java files (.java) in addition to Kotlin files"
        },
        "kotlinImplementationLens.annotationFilters": {
          "type": "array",
          "default": [
            "Component",
            "Service",
            "Repository",
            "Controller",
            "RestController"
          ],
          "description": "Spring Boot annotations to detect and highlight"
        },
        "kotlinImplementationLens.cacheTimeout": {
          "type": "number",
          "default": 300000,
          "description": "Cache timeout in milliseconds (default: 5 minutes)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^18.x",
    "@types/vscode": "^1.60.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.40.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/kotlin-implementation-lens"
  },
  "bugs": {
    "url": "https://github.com/your-username/kotlin-implementation-lens/issues"
  },
  "homepage": "https://github.com/your-username/kotlin-implementation-lens#readme",
  "license": "MIT"
}
